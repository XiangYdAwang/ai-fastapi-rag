POSTGRES_USER=aiuser
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=airag
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://aiuser:replace_me@127.0.0.1:5433/airag

UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

EMBEDDING_MODEL=openai/BAAI/bge-m3
EMBEDDING_API_KEY=replace_with_your_api_key
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1024

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=replace_with_public_key
LANGFUSE_SECRET_KEY=replace_with_secret_key
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=local

RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_API_BASE=
RERANK_TIMEOUT_SECONDS=30
STRUCTURED_CHUNK_SIZE=4000
AST_CHUNKING_ENABLED=false
PARENT_CHILD_ENABLED=false
CHILD_CHUNK_SIZE=800
CHILD_CHUNK_OVERLAP=100

